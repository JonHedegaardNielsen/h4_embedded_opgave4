{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AVR (ATmega328PB)",
            "type": "shell",
            "command": "./build.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Bygger hele projektet med avr-gcc -mmcu=atmega328pb"
        },
        {
            "label": "Flash AVR (ATmega328PB)",
            "type": "shell",
            "command": "./build.sh --flash",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Bygger og flasher via avrdude -c xplainedmini -p m328pb"
        }
    ]
}
